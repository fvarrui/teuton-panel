# frozen_string_literal: true

# Documentation site (Jekyll + Just the Docs + jekyll-polyglot).
# Kept apart from the gem's Gemfile: Jekyll needs native extensions that
# RubyInstaller cannot build without MSYS2. Build it on Linux (CI) or with
# Docker (see docs/en/developers/setup.md).

source "https://rubygems.org"

gem "jekyll", "~> 4.4"
gem "just-the-docs", "~> 0.10"
gem "jekyll-polyglot", "~> 1.8"
