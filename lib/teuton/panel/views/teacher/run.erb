<% @title = t("nav.run") %>
<%# Reload the page only while a loop runs: the form is hidden then, so nothing typed is lost %>
<% @refresh = 10 if status[:active] %>
<% used = settings_used || {} %>
<% run_cfg = config[:run] %>
<div class="page-head">
  <div>
    <h1><%= h t("teacher.run.title") %></h1>
    <p class="muted"><%= h t("teacher.run.intro", test: project.name) %></p>
  </div>
</div>

<div class="grid">
  <section class="card featured">
    <h2 class="section-title"><%= icon(:play) %> <%= h t("teacher.run.new") %></h2>
    <% if status[:active] %>
      <div class="notice warn" role="status"><%= h t("teacher.run.in_progress") %></div>
    <% else %>
    <form method="post" action="/teacher/run/start" class="run-form">
      <fieldset>
        <legend><%= h t("teacher.run.mode") %></legend>
        <div class="checks">
          <% Teuton::Panel::Scheduler::MODES.each do |mode| %>
            <label><input type="radio" id="mode-<%= mode %>" name="mode" value="<%= mode %>" <%= "checked" if (used[:mode] || "once") == mode %>> <%= h t("teacher.run.mode_#{mode}") %></label>
          <% end %>
        </div>
      </fieldset>
      <div class="run-group times">
        <div class="field"><label for="times"><%= h t("teacher.run.times") %></label><input type="number" id="times" name="times" min="1" value="<%= run_cfg[:times] %>"></div>
        <div class="field"><label for="delay"><%= h t("teacher.run.delay") %></label><input type="number" id="delay" name="delay" min="0" value="<%= run_cfg[:delay] %>"></div>
      </div>
      <div class="run-group every">
        <div class="field"><label for="every"><%= h t("teacher.run.every") %></label><input type="number" id="every" name="every" min="10" value="<%= run_cfg[:every] %>"></div>
        <div class="field"><label for="until"><%= h t("teacher.run.until") %></label><input type="datetime-local" id="until" name="until"></div>
      </div>
      <fieldset>
        <legend><%= h t("teacher.run.cases") %></legend>
        <% if rows.empty? %>
          <p class="muted"><%= h t("teacher.students.empty") %></p>
        <% else %>
          <div class="checks">
            <% rows.each do |row| %>
              <label><input type="checkbox" name="keys[]" value="<%= h row[:key] %>" <%= row[:disabled] ? "disabled" : "checked" %>> <%= h row[:data]["tt_members"] %></label>
            <% end %>
          </div>
        <% end %>
      </fieldset>
      <button class="btn" type="submit"><%= icon(:play, 18) %> <%= h t("teacher.run.start") %></button>
    </form>
    <% end %>
  </section>
  <section class="card">
    <h2 class="section-title"><%= icon(:clock) %> <%= h t("teacher.run.status") %></h2>
    <iframe class="status-frame" src="/teacher/run/status" title="<%= h t("teacher.run.status_frame") %>"></iframe>
  </section>
</div>
