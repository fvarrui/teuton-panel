<% @title = t("nav.run") %>
<%# Reload the page only while a loop runs: the form is hidden then, so nothing typed is lost %>
<% @refresh = 10 if status[:active] %>
<% used = settings_used || {} %>
<% run_cfg = config[:run] %>
<% link = ->(s, f) { query = [("sort=#{s}" unless s.empty?), ("show=#{f}" unless f == "all")].compact.join("&"); query.empty? ? "/teacher/run" : "/teacher/run?#{query}" } %>
<% selectable = rows.reject { _1[:disabled] } %>
<div class="page-head">
  <div>
    <h1><%= h t("teacher.run.title") %></h1>
    <p class="muted"><%= h t("teacher.run.intro", test: project.name) %></p>
  </div>
</div>

<section class="card">
  <h2 class="section-title"><%= icon(:clock) %> <%= h t("teacher.run.status") %></h2>
  <iframe class="status-frame" src="/teacher/run/status" title="<%= h t("teacher.run.status_frame") %>"></iframe>
</section>

<section class="card featured">
  <h2 class="section-title"><%= icon(:play) %> <%= h t("teacher.run.new") %></h2>
  <% if status[:active] %>
    <div class="notice warn" role="status"><%= h t("teacher.run.in_progress") %></div>
  <% else %>
  <form method="post" action="/teacher/run/start" class="run-form">
    <fieldset>
      <legend><%= h t("teacher.run.mode") %></legend>
      <div class="checks">
        <% Teuton::Panel::Scheduler::MODES.each do |mode| %>
          <label><input type="radio" id="mode-<%= mode %>" name="mode" value="<%= mode %>" <%= "checked" if (used[:mode] || "once") == mode %>> <%= h t("teacher.run.mode_#{mode}") %></label>
        <% end %>
      </div>
    </fieldset>
    <div class="run-group times">
      <div class="field"><label for="times"><%= h t("teacher.run.times") %></label><input type="number" id="times" name="times" min="1" value="<%= run_cfg[:times] %>"></div>
      <div class="field"><label for="delay"><%= h t("teacher.run.delay") %></label><input type="number" id="delay" name="delay" min="0" value="<%= run_cfg[:delay] %>"></div>
    </div>
    <div class="run-group every">
      <div class="field"><label for="every"><%= h t("teacher.run.every") %></label><input type="number" id="every" name="every" min="10" value="<%= run_cfg[:every] %>"></div>
      <div class="field"><label for="until"><%= h t("teacher.run.until") %></label><input type="datetime-local" id="until" name="until"></div>
    </div>

    <fieldset class="picker">
      <legend><%= h t("teacher.run.cases") %></legend>
      <nav class="filters" aria-label="<%= h t("teacher.students.show") %>">
        <span class="muted"><%= h t("teacher.students.show") %>:</span>
        <% Teuton::Panel::App::RUN_FILTERS.each do |filter| %>
          <% label = (filter == "all") ? t("teacher.students.all") : t(Teuton::Panel::App::STATE_VIEWS[filter][1]) %>
          <a href="<%= link.call(sort, filter) %>" class="<%= "current" if show == filter %>" <%= 'aria-current="true"' if show == filter %>><%= h label %></a>
        <% end %>
      </nav>
      <% if selectable.empty? %>
        <p class="muted"><%= h t(rows.empty? && show == "all" ? "teacher.students.empty" : "teacher.students.none_here") %></p>
      <% else %>
        <div class="run-start">
          <button class="btn" type="submit"><%= icon(:play, 18) %> <%= h t("teacher.run.start") %></button>
          <span class="muted run-count" data-template="<%= h t("teacher.run.selected", count: "%{n}") %>"><%= h t("teacher.run.selected", count: selectable.size) %></span>
        </div>
        <div class="table-wrap"><table class="pick-table">
          <thead><tr>
            <th class="pick"><input type="checkbox" class="pick-all" checked aria-label="<%= h t("teacher.run.select_all") %>" hidden></th>
            <th <%= 'aria-sort="ascending"' if sort == "name" %>><a class="sort <%= "current" if sort == "name" %>" href="<%= link.call("name", show) %>"><%= h t("table.student") %></a></th>
            <th <%= 'aria-sort="descending"' if sort == "grade" %>><a class="sort <%= "current" if sort == "grade" %>" href="<%= link.call("grade", show) %>"><%= h t("table.grade") %></a></th>
            <th><%= h t("table.state") %></th>
            <th><%= h t("table.when") %></th>
          </tr></thead>
          <tbody>
            <% rows.each do |row| %>
              <% finished = row[:result]&.dig("finished_at") %>
              <tr class="<%= "disabled" if row[:disabled] %>">
                <td class="pick"><% unless row[:disabled] %><input type="checkbox" name="keys[]" value="<%= h row[:key] %>" id="pick-<%= h row[:key] %>" checked><% end %></td>
                <td><label for="pick-<%= h row[:key] %>"><strong><%= h row[:data]["tt_members"] %></strong></label></td>
                <td><%= grade_bar(row[:result]&.dig("grade"), row[:disabled]) %></td>
                <td><%= state_badge(row[:disabled], row[:result]) %></td>
                <td class="nowrap"><%= h(finished ? short_time(Time.parse(finished.to_s)) : "-") %></td>
              </tr>
            <% end %>
          </tbody>
        </table></div>
        <% if selectable.size > 10 %>
          <div class="run-start"><button class="btn" type="submit"><%= icon(:play, 18) %> <%= h t("teacher.run.start") %></button></div>
        <% end %>
      <% end %>
    </fieldset>
  </form>
  <script>
    // Optional shortcuts: tick or untick every visible student, and count the ticked ones
    (function () {
      var form = document.querySelector(".run-form");
      var all = form && form.querySelector(".pick-all");
      if (!all) return;
      var boxes = form.querySelectorAll('input[name="keys[]"]');
      var counters = form.querySelectorAll(".run-count");
      function update() {
        var n = 0;
        boxes.forEach(function (box) { if (box.checked) n++; });
        all.checked = n === boxes.length;
        all.indeterminate = n > 0 && n < boxes.length;
        counters.forEach(function (c) { c.textContent = c.dataset.template.replace("%{n}", n); });
      }
      all.hidden = false;
      all.addEventListener("change", function () {
        boxes.forEach(function (box) { box.checked = all.checked; });
        update();
      });
      boxes.forEach(function (box) { box.addEventListener("change", update); });
    })();
  </script>
  <% end %>
</section>
