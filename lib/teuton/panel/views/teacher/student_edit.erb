<% @title = t("teacher.students.edit") %>
<div class="page-head">
  <div>
    <h1><%= h t("teacher.students.edit_title", name: student[:data]["tt_members"]) %></h1>
    <p class="muted"><kbd translate="no"><%= h student[:code] %></kbd> · <%= h File.basename(student[:filepath]) %></p>
  </div>
  <a class="btn secondary" href="/teacher/students"><%= h t("students.run.back") %></a>
</div>
<% unless errors.empty? %><div class="notice error"><%= h t("teacher.students.own_ip") %></div><% end %>
<section class="card featured">
  <form method="post" action="/teacher/students/<%= h student[:code] %>">
    <% spec = Teuton::Panel::Params.load(project) %>
    <% details = Teuton::Panel::Params.details(project) %>
    <% data.each do |field, value| %>
      <% readonly = Teuton::Panel::App::READONLY_FIELDS.include?(field) %>
      <div class="field <%= "error" if errors.include?(field) %>">
        <label for="d-<%= h field %>"><%= h field_label(field, spec[field], details[field]) %></label>
        <% if readonly %>
          <input type="text" id="d-<%= h field %>" value="<%= h value %>" readonly>
        <% else %>
          <input type="text" id="d-<%= h field %>" name="data[<%= h field %>]" value="<%= h value %>">
        <% end %>
        <small translate="no"><%= h field %><%= " · #{t("teacher.students.readonly")}" if readonly %></small>
      </div>
    <% end %>
    <button class="btn" type="submit"><%= h t("teacher.save") %></button>
  </form>
</section>
<section class="card">
  <h2><%= h t("teacher.students.delete_title") %></h2>
  <p class="muted"><%= h t("teacher.students.delete_text") %></p>
  <form method="post" action="/teacher/students/<%= h student[:code] %>/delete" onsubmit="return confirm('<%= h t("teacher.students.confirm_delete") %>')">
    <button class="btn danger" type="submit"><%= h t("teacher.students.delete") %></button>
  </form>
</section>
